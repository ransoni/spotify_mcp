{
  "name": "spotify-mcp",
  "version": "0.1.0",
  "description": "MCP server for controlling Spotify from Claude Desktop or, deployed to Cloud Run, from Claude.ai and mobile",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/server.js",
    "dev": "tsx watch src/index.ts",
    "dev:http": "tsx watch src/server.ts",
    "authorize": "tsx src/scripts/authorize.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.0",
    "@google-cloud/secret-manager": "^5.6.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^5.2.1",
    "open": "^10.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
