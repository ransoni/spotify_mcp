SPOTIFY_CLIENT_ID=your-spotify-client-id

# --- Cloud Run / remote HTTP deployment only ---
# Public HTTPS origin of the deployed service (e.g. https://spotify-mcp-xxxxx.a.run.app).
# Leave unset for local stdio usage (Claude Desktop).
PUBLIC_BASE_URL=

# Populated automatically by Cloud Run. Set explicitly for local testing against real
# GCP resources (npm run dev:http).
GOOGLE_CLOUD_PROJECT=

# Secret Manager secret names (defaults shown; override only if you named them differently).
SPOTIFY_TOKENS_SECRET_NAME=spotify-mcp-tokens
MCP_OWNER_PASSCODE_SECRET_NAME=mcp-owner-passcode
